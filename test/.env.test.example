# 测试环境配置文件
# 复制此文件为 .env.test 并填写真实值
# ⚠️ 警告: 永远不要提交包含真实私钥的文件到版本控制!

# ============================================
# 区块链连接配置
# ============================================

# ZetaChain Athens 测试网 RPC
TEST_RPC_URL=https://zetachain-athens.g.allthatnode.com

# 测试网链ID
TEST_CHAIN_ID=7001

# ============================================
# 钱包配置 (测试钱包 - 仅用于测试网!)
# ============================================

# ⚠️ 重要安全提示:
# 1. 仅使用测试网钱包，不要用在主网
# 2. 此私钥仅用于测试，确保钱包内只有测试代币
# 3. 定期更换测试钱包
# 4. 永远不要将此文件提交到Git

# 测试钱包私钥 (0x开头, 64位十六进制)
# 生成方式: 使用 Metamask 创建新钱包 -> 导出私钥
TEST_PRIVATE_KEY=0x

# 测试钱包地址 (与私钥对应)
TEST_WALLET_ADDRESS=0x

# ============================================
# 合约地址 (ZetaChain Athens 测试网)
# ============================================

# TravelRouter 合约地址 (部署后填写)
TRAVEL_ROUTER_ADDRESS=0x

# ZFrogNFT 合约地址
ZFROG_NFT_ADDRESS=0x

# SouvenirNFT 合约地址
SOUVENIR_NFT_ADDRESS=0x

# BadgeRegistry 合约地址
BADGE_REGISTRY_ADDRESS=0x

# ============================================
# API Keys (用于区块浏览器和外部服务)
# ============================================

# ZetaChain 区块浏览器 API Key
ZETASCAN_API_KEY=

# IPFS Pinata Keys (用于存储NFT元数据)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# AI 服务 API Keys (用于生成日记和图像)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=

# ============================================
# 数据库配置 (测试环境)
# ============================================

TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/zfrog_test

# Redis 配置
TEST_REDIS_URL=redis://localhost:6379/1

# ============================================
# 测试参数配置
# ============================================

# 测试超时时间 (毫秒)
TEST_TIMEOUT=30000

# 重试次数
TEST_RETRY_COUNT=3

# Gas价格上限 (Gwei)
MAX_GAS_PRICE=100

# ============================================
# 安全警告
# ============================================

# ⚠️⚠️⚠️ 再次警告 ⚠️⚠️⚠️
# 
# 1. 此文件包含敏感信息，永远不要提交到Git!
# 2. 使用 .gitignore 忽略此文件
# 3. 定期更换测试钱包私钥
# 4. 确保测试钱包只有测试网代币
# 5. 生产环境使用硬件钱包或托管服务
#
# ⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️
