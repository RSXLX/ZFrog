  metadata  Json? // 额外数据 (如好友信息)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  frog Frog @relation(fields: [frogId], references: [id])

  @@index([frogId, isRead])
  @@index([type])
  @@index([createdAt])
}

model TravelBadge {
