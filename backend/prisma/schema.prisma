  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // V2.0 友情值系统
  affinityLevel      Int       @default(1) // 友情等级 1-10
  groupTravelCount   Int       @default(0) // 结伴旅行次数
