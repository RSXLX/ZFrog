// 新增：旅行状态消息
model TravelStatusMessage {
  id          Int         @id @default(autoincrement())
  travelId    Int
  message     String
  messageType MessageType @default(INFO)
  createdAt   DateTime    @default(now())

  travel Travel @relation(fields: [travelId], references: [id])

  @@index([travelId])
}

// 新增：跨链探索互动记录 (周期性探索足迹)
model TravelInteraction {
