generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Frog {
  id                      Int                 @id @default(autoincrement())
  tokenId                 Int                 @unique
  name                    String
  ownerAddress            String              @unique
  birthday                DateTime
  totalTravels            Int                 @default(0)
  status                  FrogStatus          @default(Idle)
  xp                      Int                 @default(0)
  level                   Int                 @default(1)
  personality             Personality         @default(PHILOSOPHER) // 新增：性格
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  p0Travels               Int                 @default(0)
  interactions            FriendInteraction[] @relation("InteractionActor")
  receivedRequests        Friendship[]        @relation("FriendshipAddressee")
  sentRequests            Friendship[]        @relation("FriendshipRequester")
  travelStats             FrogTravelStats?
  souvenirs               Souvenir[]
  travels                 Travel[]
  badges                  UserBadge[]
  earnedTravelBadges      EarnedTravelBadge[] // 已获得的旅行徽章
  chatSessions            ChatSession[] // 新增：关联聊天会话
  groupTravelsAsLeader    GroupTravel[]       @relation("GroupTravelLeader")
  groupTravelsAsCompanion GroupTravel[]       @relation("GroupTravelCompanion")
  visitorMessages         VisitorMessage[] // 串门留言

  // 🆕 家园系统关联
  decorations        UserDecoration[] // 拥有的装饰品
  roomLayouts        RoomLayout[] // 布局配置
  receivedGifts      Gift[] // 收到的礼物
  photos             Photo[] // 相册照片
  earnedAchievements EarnedAchievement[] // 已获得的成就

  // 🆕 跨链转账关联
  transfersSent     CrossChainTransfer[] @relation("TransfersSent")
  transfersReceived CrossChainTransfer[] @relation("TransfersReceived")
  footprints        TravelFootprint[]

  // 🆕 状态系统 (饥饿/心情)
  hunger           Int             @default(100) // 饥饿值 0-100 (100=饱, 0=饥饿)
  happiness        Int             @default(100) // 快乐值 0-100
  lastFedAt        DateTime? // 上次喂食时间
  lastInteractedAt DateTime? // 上次互动时间
  foodInventory    FoodInventory[] // 食物库存

  // 🆕 宠物蛋系统 - 状态扩展
  cleanliness      Int      @default(100) // 清洁度 0-100
  health           Int      @default(100) // 健康度 0-100
  energy           Int      @default(100) // 活力值 0-100
  lastStatusUpdate DateTime @default(now()) // 状态计算基准时间
  needsClean       Boolean  @default(false) // 是否需要清洁 (排泄事件触发)

  // 🆕 宠物蛋系统 - 生病状态
  isSick    Boolean   @default(false) // 是否生病
  sickSince DateTime? // 生病开始时间

  // 🆕 宠物蛋系统 - 进化系统
  evolutionType String? // explorer/scholar/social
  canEvolve     Boolean   @default(false) // 是否可以进化
  evolvedAt     DateTime? // 进化时间

  // 🆕 宠物蛋系统 - 休息系统
  isResting    Boolean   @default(false) // 是否在休息
  restingSince DateTime? // 休息开始时间

  // 🆕 个性化外观系统
  appearanceParams Json? // FrogAppearanceParams JSON
  appearanceDesc   String? // LLM 生成的描述 (中文)
  rarityTier       String? // common/uncommon/rare/epic/legendary/hidden
  rarityScore      Int? // 0-100 稀有度分数
  isHiddenEdition  Boolean @default(false) // 是否隐藏款

  // 🆕 V2.0 家园系统新增
  treasuresHosted DailyTreasure[] @relation("TreasureHost") // 在自己家园被发现的宝藏
  treasuresFound  DailyTreasure[] @relation("TreasureVisitor") // 自己发现的宝藏
  offlineBonuses  OfflineBonus[] // 离线收益记录

  // 🆕 V2.0 旅行系统优化
  feedsSent          TravelFeed[]       @relation("FeedsSent") // 发送的投喂
  snackPreference    String? // 偏好零食类型 (worm/candy/seed/berry)
  luckyBuff          Boolean            @default(false) // 幸运爆发 Buff
  luckyBuffExpiry    DateTime? // Buff 过期时间
  addressDiscoveries AddressDiscovery[] @relation("AddressDiscoveries") // 发现的地址
  strandedRequests   RescueRequest[]    @relation("StrandedRequests") // 被困求救
  rescuesDone        RescueRequest[]    @relation("RescuesDone") // 完成的救援

  // 🆕 V3.0 通知系统
  notifications Notification[] // 通知列表

  // 🆕 P5 繁殖系统
  breedCooldownUntil     DateTime? // 繁殖冷却结束时间
  parentFrogId1          Int? // 父亲 ID (可为空表示初代)
  parentFrogId2          Int? // 母亲 ID
  generation             Int            @default(0) // 代数 (0=初代)
  breedRequestsSent      BreedRequest[] @relation("BreedRequester")
  breedRequestsReceived  BreedRequest[] @relation("BreedPartner")
  offspringBreedRequests BreedRequest[] @relation("BreedOffspring")

  // 🆕 V4.0 冬眠系统
  hibernationStatus HibernationStatus @default(ACTIVE) // 冬眠状态
  hibernatedAt      DateTime? // 进入冬眠的时间
  blessingsReceived Int               @default(0) // 收到的祈福次数

  // 🆕 V4.0 家族 DAO 系统
  familyId    Int? // 所属家族 ID
  family      Family?  @relation("FamilyMembers", fields: [familyId], references: [id])
  ledFamilies Family[] @relation("FamilyLeader") // 作为族长的家族

  // V1 核心域表
  eggProfile                       EggProfile?
  petState                         PetState?
  soulProfile                      SoulProfile?
  relationshipEvents               RelationshipEvent[] @relation("RelationshipEventFrog")
  relationshipEventsAsActor        RelationshipEvent[] @relation("RelationshipEventActor")
  relationshipEventsAsCounterparty RelationshipEvent[] @relation("RelationshipEventCounterparty")
  ritualsAsFrog                    Ritual[]            @relation("RitualFrog")
  ritualsAsTarget                  Ritual[]            @relation("RitualTarget")
  memoryPalace                     MemoryPalace?
  memorySummaries                  MemorySummary[]
  onchainMilestones                OnchainMilestone[]
  domainEvents                     DomainEvent[]

  @@index([ownerAddress])
}

model Travel {
  id     Int @id @default(autoincrement())
  frogId Int

  // 目标信息（升级）
  targetWallet String // 目标钱包地址
  targetChain  ChainType @default(ZETACHAIN_ATHENS) // 目标链类型
  chainId      Int       @default(7001) // 数值型 chainId，与合约一致

  // 随机探索支持
  isRandom       Boolean   @default(false) // 是否随机探索
  originalTarget String? // 原始目标（随机时为零地址）
  discoveredAt   DateTime? // 地址发现时间

  // 时间
  startTime DateTime
  endTime   DateTime
  duration  Int      @default(3600) // 旅行时长（秒），默认1小时

  // 状态
  status       TravelStatus @default(Active)
  currentStage TravelStage  @default(DEPARTING) // 当前阶段
  progress     Int          @default(0) // 进度 0-100

  // 跨链交易追踪
  startTxHash    String? // 开始旅行的交易哈希
  completeTxHash String? // 完成旅行的交易哈希

  // 观察结果
  observedTxCount    Int?
  observedTotalValue String?

  // AI 生成内容
  journalHash    String?
  journalContent String?

  // 纪念品
  souvenirId Int?

  // 错误处理
  errorMessage String? // 错误信息

  // 时间戳
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ============ 跨链旅行相关 ============
  isCrossChain           Boolean           @default(false) // 是否真正跨链旅行
  crossChainStatus       CrossChainStatus? // 跨链状态
  footprints             TravelFootprint[]
  crossChainMessageId    String? // 跨链消息ID
  lockTxHash             String? // 锁定交易哈希
  unlockTxHash           String? // 解锁交易哈希
  targetChainArrivalTime DateTime? // 目标链到达时间
  targetChainActions     Json? // 目标链操作记录
  returnMessageId        String? // 返回消息ID
  crossChainXpEarned     Int? // 跨链获得的XP
  refundAmount           String? // 干粮返还金额 (wei)

  // 兼容旧字段
  exploredBlock         BigInt?
  exploredTimestamp     DateTime?
  exploredSnapshot      Json?
  diary                 String?
  diaryMood             DiaryMood?
  souvenirData          Json?
  addressDiscoveredAt   DateTime?
  originalTargetAddress String?

  // 关联
  frog              Frog                  @relation(fields: [frogId], references: [id])
  souvenir          Souvenir?             @relation(fields: [souvenirId], references: [id])
  observations      WalletObservation[]
  groupTravel       GroupTravel? // 结伴旅行信息
  statusMessages    TravelStatusMessage[] // 状态消息
  discoveries       TravelDiscovery[] // 旅行发现
  interactions      TravelInteraction[] // 跨链探索互动记录
  visitorMessages   VisitorMessage[] // 串门留言
  photos            Photo[] // 🆕 旅行照片
  feeds             TravelFeed[] // 🆕 V2.0 投喂记录
  rescueRequest     RescueRequest? // 🆕 V2.0 救援请求
  onchainMilestones OnchainMilestone[]
  domainEvents      DomainEvent[]

  @@index([frogId])
  @@index([status])
  @@index([endTime])
  @@index([targetChain]) // 新增索引
  @@index([exploredBlock])
  @@index([isRandom])
  @@index([addressDiscoveredAt])
}

model AuthNonce {
  id            String    @id @default(uuid())
  walletAddress String
  nonce         String
  message       String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([walletAddress, createdAt])
  @@index([walletAddress, expiresAt])
  @@index([walletAddress, usedAt])
  @@map("auth_nonces")
}

model HumanVerification {
  id            String   @id @default(uuid())
  walletAddress String
  action        String
  signal        String?
  nullifierHash String?  @unique
  proof         Json
  verified      Boolean  @default(true)
  provider      String   @default("world")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress, action])
  @@index([action, createdAt])
  @@map("human_verifications")
}

model IntegrationApp {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  name        String
  appType     String
  status      String                  @default("ACTIVE")
  metadata    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  permissions IntegrationPermission[]
  keys        IntegrationKey[]

  @@index([appType, status])
  @@map("integration_apps")
}

model IntegrationPermission {
  id         String         @id @default(cuid())
  appId      String
  permission String
  createdAt  DateTime       @default(now())
  app        IntegrationApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, permission])
  @@index([permission])
  @@map("integration_permissions")
}

model IntegrationKey {
  id         String         @id @default(cuid())
  appId      String
  label      String?
  keyPrefix  String         @unique
  secretHash String
  status     String         @default("ACTIVE")
  issuedBy   String?
  issuedAt   DateTime       @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  app        IntegrationApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, status])
  @@index([expiresAt])
  @@map("integration_keys")
}

model CouncilRun {
  id               String   @id
  appId            String
  keyId            String
  requestedByActor String
  requestId        String?
  focus            String
  objective        String?
  rationale        String
  riskLevel        String
  dataSources      Json
  suggestedActions Json
  traceId          String   @unique
  promptKitVersion String
  model            String
  fingerprint      String
  createdAt        DateTime @default(now())
  suggestion       CouncilSuggestion?

  @@index([appId, createdAt])
  @@map("council_runs")
}

model CouncilSuggestion {
  id             String   @id
  runId          String   @unique
  title          String
  focus          String
  objective      String?
  rationale      String
  riskLevel      String
  riskReason     String
  dataSources    Json
  suggestedActions Json
  status         String   @default("OPEN")
  createdByAppId String
  createdByKeyId String
  createdByActor String
  requestId      String?
  updatedByActor String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  run            CouncilRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  response       CouncilResponse?

  @@index([createdByAppId, status, createdAt])
  @@map("council_suggestions")
}

model CouncilResponse {
  id               String            @id @default(cuid())
  suggestionId     String            @unique
  decision         String
  note             String?
  respondedByAppId String
  respondedByActor String
  respondedAt      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  suggestion       CouncilSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([respondedByAppId, respondedAt])
  @@map("council_responses")
}

model EggProfile {
  id           Int       @id @default(autoincrement())
  frogId       Int       @unique
  claimStatus  String    @default("HATCHED")
  claimedAt    DateTime?
  hatchReadyAt DateTime?
  hatchedAt    DateTime?
  imprintSeed  String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  frog Frog @relation(fields: [frogId], references: [id])

  @@index([claimStatus])
  @@map("egg_profiles")
}

model PetState {
  id              Int       @id @default(autoincrement())
  frogId          Int       @unique
  lifeStage       String    @default("ACTIVE")
  hunger          Int       @default(100)
  happiness       Int       @default(100)
  health          Int       @default(100)
  energy          Int       @default(100)
  cleanliness     Int       @default(100)
  isSick          Boolean   @default(false)
  isDormant       Boolean   @default(false)
  lastCareAt      DateTime?
  lastStateSyncAt DateTime  @default(now())
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  frog Frog @relation(fields: [frogId], references: [id])

  @@index([lifeStage])
  @@map("pet_states")
}

model SoulProfile {
  id          Int       @id @default(autoincrement())
  frogId      Int       @unique
  personality String?
  imprintText String?
  temperament Json?
  bondedAt    DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  frog Frog @relation(fields: [frogId], references: [id])

  @@map("soul_profiles")
}

model RelationshipEvent {
  id                 BigInt   @id @default(autoincrement())
  frogId             Int
  actorFrogId        Int?
  counterpartyFrogId Int?
  eventType          String
  payload            Json?
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  frog         Frog  @relation("RelationshipEventFrog", fields: [frogId], references: [id])
  actor        Frog? @relation("RelationshipEventActor", fields: [actorFrogId], references: [id])
  counterparty Frog? @relation("RelationshipEventCounterparty", fields: [counterpartyFrogId], references: [id])

  @@index([frogId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("relationship_events")
}

model RelationshipAttestation {
  id               String   @id @default(cuid())
  subjectFrogId    Int
  objectFrogId     Int
  attestationType  String
  source           String
  evidence         Json?
  status           String   @default("QUEUED")
  idempotencyKey   String?  @unique
  requestId        String?
  createdByAddress String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  onchainMilestones OnchainMilestone[]

  @@index([subjectFrogId, createdAt])
  @@index([objectFrogId, createdAt])
  @@index([attestationType, createdAt])
  @@index([status, createdAt])
  @@unique([subjectFrogId, objectFrogId, attestationType, source])
  @@map("relationship_attestations")
}

model Ritual {
  id           BigInt    @id @default(autoincrement())
  frogId       Int
  targetFrogId Int?
  ritualType   String
  status       String    @default("PENDING")
  payload      Json?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  frog       Frog  @relation("RitualFrog", fields: [frogId], references: [id])
  targetFrog Frog? @relation("RitualTarget", fields: [targetFrogId], references: [id])

  @@index([frogId, ritualType])
  @@index([status, createdAt])
  @@index([targetFrogId])
  @@map("rituals")
}

model MemoryPalace {
  id         Int      @id @default(autoincrement())
  frogId     Int      @unique
  recapText  String?  @db.Text
  timeline   Json?
  highlights Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  frog Frog @relation(fields: [frogId], references: [id])

  @@map("memory_palaces")
}

model MemoryPalaceWorld {
  id             String                    @id
  journeyId      String
  title          String
  summary        String?                   @db.Text
  templateSlug   String?
  status         String                    @default("ACTIVE")
  ownerAppId     String
  ownerKeyId     String
  createdByActor String
  requestId      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  collaborators  MemoryPalaceCollaborator[]
  contributions  MemoryPalaceContribution[]
  visits         MemoryPalaceVisit[]
  exhibits       MemoryPalaceExhibit[]

  @@index([ownerAppId, createdAt])
  @@index([journeyId, createdAt])
  @@index([status, createdAt])
  @@map("memory_palace_worlds")
}

model MemoryPalaceCollaborator {
  id           String           @id @default(cuid())
  worldId      String
  appId        String
  role         String           @default("CONTRIBUTOR")
  addedByActor String
  createdAt    DateTime         @default(now())
  world        MemoryPalaceWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, appId])
  @@index([appId, createdAt])
  @@map("memory_palace_collaborators")
}

model MemoryPalaceContribution {
  id        String            @id
  worldId   String
  appId     String
  actor     String
  type      String
  content   String            @db.Text
  metadata  Json?
  requestId String?
  createdAt DateTime          @default(now())
  world     MemoryPalaceWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, createdAt])
  @@index([appId, createdAt])
  @@index([type, createdAt])
  @@map("memory_palace_contributions")
}

model MemoryPalaceVisit {
  id             String              @id
  worldId        String
  visitorAppId   String
  visitorKeyId   String
  visitorActor   String
  entryType      String              @default("GUESTBOOK")
  message        String              @db.Text
  metadata       Json?
  requestId      String?
  createdAt      DateTime            @default(now())
  world          MemoryPalaceWorld   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  featuredExhibit MemoryPalaceExhibit?

  @@index([worldId, createdAt])
  @@index([visitorAppId, createdAt])
  @@index([entryType, createdAt])
  @@map("memory_palace_visits")
}

model MemoryPalaceExhibit {
  id             String            @id
  worldId        String
  visitId        String            @unique
  featuredByActor String
  featureReason  String?           @db.Text
  metadata       Json?
  requestId      String?
  featuredAt     DateTime          @default(now())
  world          MemoryPalaceWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  visit          MemoryPalaceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([worldId, featuredAt])
  @@index([featuredByActor, featuredAt])
  @@map("memory_palace_exhibits")
}

model MemoryPalaceTemplate {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  status         String   @default("DRAFT")
  config         Json?
  createdByAppId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdByAppId, createdAt])
  @@map("memory_palace_templates")
}

model CreatorProfile {
  id        String         @id @default(cuid())
  appId     String         @unique
  status    String         @default("ACTIVE")
  metadata  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  assets    CreatorAsset[]
  packs     CreatorPack[]

  @@index([status, createdAt])
  @@map("creator_profiles")
}

model CreatorAsset {
  id             String             @id
  creatorAppId   String
  createdByKeyId String
  createdByActor String
  requestId      String?
  assetType      String
  mimeType       String
  sourceUrl      String
  checksum       String
  bytes          Int
  status         String             @default("READY")
  preview        Json
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  profile        CreatorProfile     @relation(fields: [creatorAppId], references: [appId], onDelete: Cascade)
  packAssets     CreatorPackAsset[]
  licenseBindings CreatorAssetBinding[]

  @@index([creatorAppId, createdAt])
  @@index([assetType, status, createdAt])
  @@map("creator_assets")
}

model CreatorPack {
  id             String             @id
  creatorAppId   String
  slug           String
  title          String
  summary        String?            @db.Text
  status         String             @default("DRAFT")
  previewState   String             @default("READY")
  createdByKeyId String
  createdByActor String
  requestId      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  profile        CreatorProfile     @relation(fields: [creatorAppId], references: [appId], onDelete: Cascade)
  assets         CreatorPackAsset[]

  @@unique([creatorAppId, slug])
  @@index([creatorAppId, status, createdAt])
  @@map("creator_packs")
}

model CreatorPackAsset {
  id        String      @id @default(cuid())
  packId    String
  assetId   String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  pack      CreatorPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  asset     CreatorAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([packId, assetId])
  @@index([assetId])
  @@index([packId, sortOrder])
  @@map("creator_pack_assets")
}

model CreatorAssetBinding {
  id                  String              @id
  assetId             String
  creatorAppId        String
  checksum            String
  ownerWallet         String
  issuedAt            DateTime
  anchorDigest        String
  status              String              @default("BOUND")
  replayCount         Int                 @default(0)
  lastError           String?
  onchainRequired     Boolean             @default(false)
  anchoredAt          DateTime?
  createdByKeyId      String
  createdByActor      String
  lastReplayedByActor String?
  requestId           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  asset               CreatorAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  onchainAnchor       OnchainCreatorAsset?

  @@unique([assetId, checksum, ownerWallet, issuedAt])
  @@index([creatorAppId, status, createdAt])
  @@index([assetId, createdAt])
  @@index([status, updatedAt])
  @@map("creator_asset_bindings")
}

model OnchainCreatorAsset {
  id         String              @id
  bindingId  String              @unique
  anchorId   String              @unique
  mode       String              @default("mock")
  chainId    Int?
  txHash     String?
  blockNumber BigInt?
  payload    Json?
  anchoredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  binding    CreatorAssetBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([chainId, anchoredAt])
  @@index([txHash, anchoredAt])
  @@map("onchain_creator_assets")
}

model RelationshipEdge {
  id                 String   @id
  scopeAppId         String
  frogId             Int
  peerFrogId         Int
  score              Int      @default(0)
  signalCount        Int      @default(0)
  journeyCount       Int      @default(0)
  rescueCount        Int      @default(0)
  witnessCount       Int      @default(0)
  contributionCount  Int      @default(0)
  firstOccurredAt    DateTime
  lastOccurredAt     DateTime
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  anchors            RelationshipEdgeAnchor[]

  @@unique([scopeAppId, frogId, peerFrogId])
  @@index([scopeAppId, frogId, lastOccurredAt])
  @@index([scopeAppId, peerFrogId, lastOccurredAt])
  @@index([scopeAppId, score, lastOccurredAt])
  @@map("relationship_edges")
}

model RelationshipEdgeAnchor {
  id                  String                          @id
  scopeAppId          String
  edgeId              String
  frogId              Int
  peerFrogId          Int
  anchorDigest        String
  status              String                          @default("PENDING")
  replayCount         Int                             @default(0)
  lastError           String?
  onchainRequired     Boolean                         @default(false)
  anchoredAt          DateTime?
  createdByKeyId      String
  createdByActor      String
  lastReplayedByActor String?
  requestId           String?
  edgeSnapshot        Json?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  edge                RelationshipEdge                @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  onchainAnchor       OnchainRelationshipEdgeAnchor?

  @@unique([scopeAppId, edgeId, anchorDigest])
  @@index([scopeAppId, status, updatedAt])
  @@index([scopeAppId, frogId, updatedAt])
  @@index([edgeId, createdAt])
  @@map("relationship_edge_anchors")
}

model OnchainRelationshipEdgeAnchor {
  id             String                   @id
  anchorRecordId String                   @unique
  anchorId       String                   @unique
  mode           String                   @default("mock")
  chainId        Int?
  txHash         String?
  blockNumber    BigInt?
  payload        Json?
  anchoredAt     DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  anchorRecord   RelationshipEdgeAnchor   @relation(fields: [anchorRecordId], references: [id], onDelete: Cascade)

  @@index([chainId, anchoredAt])
  @@index([txHash, anchoredAt])
  @@map("onchain_relationship_edge_anchors")
}

model RelationshipEdgeSnapshot {
  id                String   @id
  scopeAppId        String
  frogId            Int
  version           Int      @default(1)
  computedAt        DateTime @default(now())
  totalEdges        Int
  totalScore        Int
  strongestPeerFrogId Int?
  strongestScore    Int?
  digest            String
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([scopeAppId, frogId, computedAt])
  @@index([scopeAppId, computedAt])
  @@map("relationship_edge_snapshots")
}

model PartnerCampaign {
