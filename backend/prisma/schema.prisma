  feedCount    Int      @default(0) // 喂食次数 (上限3)
  playCount    Int      @default(0) // 玩耍次数 (上限1)
  giftCount    Int      @default(0) // 送礼次数 (无上限)
  messageCount Int      @default(0) // 留言次数 (上限10)
  travelCount  Int      @default(0) // 结伴旅行 (上限1)

  friendship Friendship @relation(fields: [friendshipId], references: [id])

  @@unique([friendshipId, date])
  @@index([friendshipId])
}

// V3.0 通知系统
model Notification {
