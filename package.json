{
  "name": "zfrog-workspace",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "ZFrog root workspace scaffold (V2-00)",
  "workspaces": [
    "frontend",
    "backend",
    "admin",
    "desktop-pet",
    "contracts",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash ./start.sh",
    "ws:dev": "bash ./start.sh --workspace",
    "legacy:dev": "bash ./start.sh --legacy",
    "rollback:dev:legacy": "bash ./scripts/cutover/rollback-to-legacy.sh",
    "legacy:frontend": "npm --prefix frontend run dev",
    "legacy:backend": "npm --prefix backend run dev",
    "legacy:admin": "npm --prefix admin run dev",
    "legacy:desktop": "npm --prefix desktop-pet run dev",
    "legacy:contracts:test": "npm --prefix contracts run test",
    "legacy:build:frontend": "npm --prefix frontend run build",
    "legacy:build:backend": "npm --prefix backend run build",
    "legacy:build:admin": "npm --prefix admin run build",
    "legacy:build:desktop": "npm --prefix desktop-pet run build",
    "legacy:build:contracts": "npm --prefix contracts run compile",
    "ws:dev:frontend": "pnpm --filter ./frontend dev",
    "ws:dev:backend": "pnpm --filter ./backend dev",
    "ws:dev:admin": "pnpm --filter ./admin dev",
    "ws:dev:desktop": "pnpm --filter ./desktop-pet dev",
    "ws:test:contracts": "pnpm --filter ./contracts test",
    "ws:build:frontend": "pnpm --filter ./frontend build",
    "ws:build:backend": "pnpm --filter ./backend build",
    "ws:build:admin": "pnpm --filter ./admin build",
    "ws:build:desktop": "pnpm --filter ./desktop-pet build",
    "ws:build:contracts": "pnpm --filter ./contracts compile",
    "ws:list": "pnpm -r list --depth -1",
    "cutover:fallback:report": "node ./scripts/cutover/legacy-fallback-report.mjs",
    "cutover:fallback:gate": "node ./scripts/cutover/legacy-fallback-gate-check.mjs",
    "ci:smoke:legacy": "npm ci --prefix backend && npm ci --prefix frontend && npm --prefix backend run db:generate && npm --prefix backend run build && npm --prefix frontend run test -- --passWithNoTests",
    "ci:smoke:workspace": "pnpm install --no-frozen-lockfile && pnpm --filter ./backend run db:generate && pnpm --filter ./backend build && pnpm --filter ./frontend test -- --passWithNoTests",
    "ci:gate:v2-rc": "node ./scripts/ci/v2-rc-gate-check.mjs",
    "ci:gate:v2:health-summary": "node ./scripts/ci/v2-release-health-summary.mjs",
    "ci:gate:v2:p1-dispatch": "node ./scripts/ci/v2-p1-escalation-dispatch.mjs",
    "ci:gate:v2:p1-dispatch:quality": "node ./scripts/ci/v2-p1-dispatch-quality-gate.mjs",
    "ci:gate:v2:p1-timeout": "node ./scripts/ci/v2-p1-escalation-timeout-gate.mjs",
    "ci:gate:v2:p1-timeout:stability": "node ./scripts/ci/v2-p1-timeout-stability-observation-gate.mjs",
    "ci:gate:v2-rc:archive": "node ./scripts/ci/v2-rc-gate-archive.mjs",
    "ci:gate:v2-rc:test": "node --test ./scripts/ci/v2-rc-gate-lib.test.mjs ./scripts/ci/v2-rc-gate-archive-lib.test.mjs",
    "ci:gate:v2:health-summary:test": "node --test ./scripts/ci/v2-release-health-summary-lib.test.mjs",
    "ci:gate:v2:p1-dispatch:test": "node --test ./scripts/ci/v2-p1-escalation-dispatch-lib.test.mjs",
    "ci:gate:v2:p1-dispatch:quality:test": "node --test ./scripts/ci/v2-p1-dispatch-quality-gate-lib.test.mjs",
    "ci:gate:v2:p1-timeout:test": "node --test ./scripts/ci/v2-p1-escalation-timeout-gate-lib.test.mjs",
    "ci:gate:v2:p1-timeout:stability:test": "node --test ./scripts/ci/v2-p1-timeout-stability-observation-gate-lib.test.mjs",
    "ci:gate:v3:beta": "node ./scripts/ci/v3-beta-release-gate.mjs",
    "ci:gate:v3:beta:test": "node --test ./scripts/ci/v3-beta-release-gate-lib.test.mjs",
    "ci:gate:v3:rc": "node ./scripts/ci/v3-rc-gate-check.mjs",
    "ci:gate:v3:rc:archive": "node ./scripts/ci/v3-rc-gate-archive.mjs",
    "ci:gate:v3:rc:test": "node --test ./scripts/ci/v3-rc-gate-lib.test.mjs ./scripts/ci/v3-rc-gate-archive-lib.test.mjs",
    "ci:gate:v3:health-summary": "node ./scripts/ci/v3-release-health-summary.mjs",
    "ci:gate:v3:health-summary:test": "node --test ./scripts/ci/v3-release-health-summary-lib.test.mjs",
    "ci:gate:v3:dashboard:drill": "node ./scripts/ci/v3-dashboard-drill-report.mjs",
    "ci:gate:v3:dashboard:drill:test": "node --test ./scripts/ci/v3-dashboard-drill-report-lib.test.mjs",
    "ci:gate:v3:dashboard:backlog": "node ./scripts/ci/v3-dashboard-drill-backlog.mjs",
    "ci:gate:v3:dashboard:backlog:test": "node --test ./scripts/ci/v3-dashboard-drill-backlog-lib.test.mjs",
    "ci:gate:v3:dashboard:backlog:apply": "node ./scripts/ci/v3-dashboard-drill-backlog-apply.mjs",
    "ci:gate:v3:dashboard:backlog:apply:test": "node --test ./scripts/ci/v3-dashboard-drill-backlog-apply-lib.test.mjs",
    "ci:gate:v3:dashboard:manifest": "node ./scripts/ci/v3-dashboard-drill-run-manifest.mjs",
    "ci:gate:v3:dashboard:manifest:test": "node --test ./scripts/ci/v3-dashboard-drill-run-manifest-lib.test.mjs",
    "ci:gate:v3:dashboard:evidence": "node ./scripts/ci/v3-dashboard-drill-evidence-gate.mjs",
    "ci:gate:v3:dashboard:evidence:test": "node --test ./scripts/ci/v3-dashboard-drill-evidence-gate-lib.test.mjs",
    "ci:gate:v3:dashboard:closeout": "node ./scripts/ci/v3-dashboard-drill-closeout.mjs",
    "ci:gate:v3:dashboard:closeout:test": "node --test ./scripts/ci/v3-dashboard-drill-closeout-lib.test.mjs",
    "ci:gate:v3:dashboard:closeout:apply": "node ./scripts/ci/v3-dashboard-drill-closeout-apply.mjs",
    "ci:gate:v3:dashboard:closeout:apply:test": "node --test ./scripts/ci/v3-dashboard-drill-closeout-apply-lib.test.mjs",
    "cutover:fallback:test": "node --test ./scripts/cutover/legacy-fallback-report-lib.test.mjs ./scripts/cutover/legacy-fallback-gate-lib.test.mjs"
  }
}
