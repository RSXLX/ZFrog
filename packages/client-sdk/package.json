{
  "name": "@zfrog/client-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "ZFrog shared HTTP/WS/auth client sdk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:contract": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
